# Ruta relativa: en desarrollo la sirve el proxy de Vite (ver vite.config.ts),
# evitando CORS para que viaje la cookie de sesión.
VITE_API_URL=/api/v1

# Destino del proxy de desarrollo. El API local corre en 8080 según su README,
# pero la instancia con autenticación está en 8082.
VITE_API_PROXY_TARGET=http://localhost:8082
